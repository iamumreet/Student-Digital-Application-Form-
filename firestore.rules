rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to verify authorized staff
    function isStaff() {
      return request.auth != null && (
        request.auth.token.email.lower() == 'umreetkumar@gmail.com' ||
        request.auth.token.email.lower() == 'ubmotionpicturesmusic@gmail.com'
      );
    }

    // Students collection:
    // Anyone with the public link can submit their enquiry (create)
    // Only authenticated authorized staff can view (read), update, or delete applications
    match /students/{studentId} {
      allow create: if true;
      allow read, update, delete: if isStaff();

      match /{subcollection}/{docId} {
        allow create: if true;
        allow read, update, delete: if isStaff();
      }
    }

    // Counters collection for generating sequential Lead IDs (e.g. PF-2026-000001)
    match /counters/{counterId} {
      allow read, write: if true;
    }

    // Response Spreadsheet rows collection
    match /response_spreadsheet_rows/{rowId} {
      allow create: if true;
      allow read, update, delete: if isStaff();
    }

    // Counsellors directory
    match /counsellors/{counsellorId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // System settings
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isStaff();
    }
  }
}

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to verify authorized staff
    function isStaff() {
      return request.auth != null &&
        request.auth.token.email != null && (
          request.auth.token.email.lower() in [
            'umreetkumar@gmail.com',
            'reception.pathfinders@gmail.com',
            'admission@pathfinders.com.np',
            'bdm@pathfinders.com.np',
            'director@pathfinders.com.np',
            'australia@pathfinders.com.np',
            'info@pathfinders.com.np',
            'uk@pathfinders.com.np',
            'ubmotionpicturesmusic@gmail.com'
          ]
        );
    }

    // Students collection:
    // Anyone with the public link can submit their enquiry (create)
    // Only authenticated authorized staff can view (read), delete, or manage applications
    // Post-submission updates for notification status & PDF references are allowed
    // Note: Staff in-app read/unread notification state can ONLY be modified by authenticated staff (isStaff())
    match /students/{studentId} {
      allow create: if true;
      allow read, delete: if isStaff();
      allow update: if isStaff() || request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'notificationStatus',
        'staffNotificationStatus',
        'studentNotificationStatus',
        'statusHistory',
        'notificationSentAt',
        'notificationRecipients',
        'notificationError',
        'emailStatus',
        'emailRecipient',
        'emailSentAt',
        'emailError',
        'pdfUrl',
        'pdfGeneratedAt',
        'spreadsheetSynced',
        'spreadsheetSyncedAt',
        'updatedAt'
      ]);

      match /{subcollection}/{docId} {
        allow create: if true;
        allow read, update, delete: if isStaff();
      }
    }

    // Counters collection for generating sequential Lead IDs (e.g. PF-2026-000001)
    match /counters/{counterId} {
      allow read, write: if true;
    }

    // Response Spreadsheet rows collection
    match /response_spreadsheet_rows/{rowId} {
      allow create: if true;
      allow read, update, delete: if isStaff();
    }

    // Counsellors directory
    match /counsellors/{counsellorId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // System settings
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isStaff();
    }
  }
}
